{
  "schemaVersion": 1,
  "id": "simplevoiceanimations",
  "version": "${mod_version}",
  "name": "Simple Voice Animations",
  "description": "Simple Voice Animations",
  "authors": [
    "Max Henkel"
  ],
  "contributors": [
    "Missing_Love"
  ],
  "contact": {
    "sources": "https://github.com/henkelmax/simple-voice-animations",
    "issues": "https://github.com/henkelmax/simple-voice-animations/issues"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.maxhenkel.simplevoiceanimations.SimpleVoiceAnimations"
    ],
    "client": [
      "de.maxhenkel.simplevoiceanimations.SimpleVoiceAnimationsClient"
    ],
    "voicechat": [
      "de.maxhenkel.simplevoiceanimations.SimpleVoiceChatPlugin"
    ],
    "modmenu": [
      "de.maxhenkel.simplevoiceanimations.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "simplevoiceanimations.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "voicechat_api": ">=${voicechat_api_version}"
  },
  "breaks": {
    "fabric-api": "${fabric_api_dependency_breaks}",
    "voicechat_api": "<${voicechat_api_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
